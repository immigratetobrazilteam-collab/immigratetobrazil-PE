{
    "persona": {
        "label": "Northeast Cultural",
        "tone": "Festive, historical, vibrant",
        "visual_intensity": "high",
        "risk_tolerance": "expressive"
    },
    "tokens": {
        "colors": {
            "primary": "#ed8936",
            "secondary": "#dd6b20",
            "accent": "#f6ad55",
            "bg": "#fffaf0",
            "text": "#c05621",
            "hover": "#c05621",
            "active": "#9c4221",
            "focus": "#ed8936",
            "success": "#48bb78",
            "error": "#f56565",
            "warning": "#faf089",
            "info": "#4299e1",
            "neutral": "#feebc8",
            "link": "#dd6b20",
            "border": "#f6ad55",
            "surface": "#feebc8",
            "gradient_bg": "linear-gradient(to top left, #fffaf0, #feebc8)"
        },
        "typography": {
            "primary_font": "'Zilla Slab', system-ui, sans-serif",
            "base_size": "18px",
            "line_height": "1.45",
            "heading_sizes": [
                "3.1rem",
                "2.6rem",
                "2.2rem",
                "1.9rem",
                "1.6rem",
                "1.4rem"
            ]
        },
        "spacing": {
            "xs": "5px",
            "s": "10px",
            "m": "20px",
            "l": "35px",
            "xl": "50px",
            "xxl": "75px"
        },
        "borders": {
            "radius": "11px"
        },
        "shadows": {
            "low": "0 6px 12px rgba(237,137,54,0.1)",
            "medium": "0 15px 30px rgba(237,137,54,0.15)"
        },
        "motion": {
            "timing": "0.6s cubic-bezier(0.34, 1.56, 0.64, 1)"
        },
        "breakpoints": {
            "tablet": "800px",
            "desktop": "1200px"
        },
        "animations": {
            "duration_base": 0.6,
            "ease_default": "easeInOutQuart",
            "intensity_mod": 1.2,
            "risk_ease": "back.inOut(1.7)",
            "mobile_mod": 0.7
        }
    },
    "page_customizations": {
        "home": {
            "hero_bg": "var(--color-surface)",
            "cta_color": "var(--color-accent)",
            "section_border": "var(--color-border)"
        },
        "about": {
            "intro_text": "var(--color-text)",
            "section_border": "var(--color-border)",
            "hero_bg": "var(--color-neutral)"
        },
        "services": {
            "overview_bg": "var(--color-surface)",
            "item_accent": "var(--color-accent)",
            "list_color": "var(--color-info)"
        },
        "contact": {
            "form_bg": "var(--color-surface)",
            "submit_btn": "var(--color-primary)",
            "input_border": "var(--color-border)"
        }
    }
